# File: backend/.env.example
# Copy to backend/.env and adjust. NEVER commit the real .env file.

# --- Node integration server -------------------------------------------------
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
UPLOADS_DIR=
# Serve the built frontend (frontend/dist) from this server.
SERVE_FRONTEND=false

# --- Django backend (system of record) --------------------------------------
# Every account/attendance/content API call is forwarded here.
DJANGO_BASE_URL=http://127.0.0.1:8000
DJANGO_TIMEOUT_MS=15000

# --- Attendance --------------------------------------------------------------
# NOTE: Admin credentials are now stored (hashed) in the Django database, not
# here. Create the first administrator with:
#   .\.venv\Scripts\python.exe django_backend\manage.py createsuperuser
# The old ADMIN_USER / ADMIN_PASS variables are intentionally removed so there
# is only ONE authentication system.
ATTENDANCE_TIME_ZONE=Asia/Kolkata