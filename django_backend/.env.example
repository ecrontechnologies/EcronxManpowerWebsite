# Ecronx Django backend configuration.
# Copy this file to django_backend/.env and fill in your own values.
# NEVER commit the real .env file or share these secrets.

# --- Django core ------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Database ---------------------------------------------------------------
# sqlite (default) | postgresql | mysql
DJANGO_DB_ENGINE=sqlite
# SQLite path (used when DJANGO_DB_ENGINE=sqlite)
DJANGO_DB_PATH=
# For PostgreSQL / MySQL, set these instead:
# DJANGO_DB_NAME=ecronx
# DJANGO_DB_USER=ecronx
# DJANGO_DB_PASSWORD=replace-me
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- CORS (existing frontend origins only) ----------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# --- Attendance -------------------------------------------------------------
ATTENDANCE_TIME_ZONE=Asia/Kolkata
TOKEN_TTL_HOURS=12

# --- Email (administrator password recovery) --------------------------------
# For real delivery, use the SMTP backend and set your mail provider details.
# Local development default prints codes to the server console.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=your-address@example.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DJANGO_DEFAULT_FROM_EMAIL=Ecronx Attendance <no-reply@ecronxtechnologies.com>
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TICKET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
